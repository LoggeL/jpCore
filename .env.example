# Runtime mode
NODE_ENV=development
PORT=3000
HOST=http://localhost:3000

# Database
DATABASE_PATH=./data.sqlite

# Session cookie
SESSION_COOKIE_NAME=jpcore_session
SESSION_TTL_DAYS=14
SESSION_SECRET=replace-with-32-random-bytes-base64

# Password hashing (argon2id is the default; PBKDF2 values used only for legacy-hash verification)
PBKDF2_ITERATIONS=100000
PBKDF2_HASH_BYTES=32
PBKDF2_DIGEST=sha512

# Dev static serving — path to jp-site for @fastify/static at / (leave empty to disable)
JPSITE_PATH=../jp-site

# CORS allow-list (comma-separated origins). Leave empty when serving jp-site from same origin.
CORS_ORIGINS=

# Email (Resend primary, Nodemailer SMTP fallback)
RESEND_API_KEY=
EMAIL_FROM=noreply@logge.top
EMAIL_REPLY_TO=noreply@logge.top
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram alerting for error-level logs (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backup destination (relative to cwd or absolute)
BACKUP_DIR=./backups
